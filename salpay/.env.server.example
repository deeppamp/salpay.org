# Copy this file to .env.server before running server scripts.

# Public domain
DOMAIN=salpay.org

# Frontend points to nginx path /api, then nginx proxies to backend.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend runtime
NODE_ENV=production
BACKEND_PORT=3001
CORS_ALLOW_ORIGIN=https://salpay.org

# Wallet RPC URL as seen from backend container.
# host.docker.internal requires Docker host-gateway mapping (already set in compose).
SALVIUM_RPC_URL=http://host.docker.internal:29088/json_rpc

# Payment mode:
# - relay: backend submits transfers through server wallet RPC
# - client_wallet: backend only resolves destination; user sends from local wallet
PAYMENT_MODE=relay

# Resolver policy:
# - true: only names minted/verified by salpay service resolve and appear in suggestions
# - false: include local fallback demo names in resolve/suggest
RESOLVE_VERIFIED_ONLY=true

# Mint payment verification mode:
# - client_attested: trust user-submitted amount/tx metadata after validation checks
# - chain_proof: require wallet RPC on-chain proof (tx hash, destination, amount, confirmations)
MINT_PAYMENT_VERIFICATION_MODE=chain_proof
MINT_CHAIN_PROOF_MIN_CONFIRMATIONS=1

# Optional authoritative uniqueness gate used before final mint execute.
# Endpoint should return JSON with either `available` boolean or `exists`/`taken` boolean.
AUTHORITATIVE_NAME_CHECK_URL=
AUTHORITATIVE_NAME_CHECK_FAIL_CLOSED=true
AUTHORITATIVE_NAME_CHECK_TIMEOUT_MS=2500

# Operational alerting windows for failed reserve/verify/execute/send/register decisions.
OPS_ALERT_WINDOW_SECONDS=300
OPS_ALERT_FAILURE_THRESHOLD=10
OPS_ALERT_COOLDOWN_SECONDS=120

# Cloudflare Turnstile
# Site key is public (frontend). Secret must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Production default should enforce Turnstile after keys are set.
TURNSTILE_ENFORCE=true

# App-level per-IP rate limits (Cloudflare still applies at edge first)
RATE_LIMIT_SEND_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_SUGGEST_PER_MINUTE=120
