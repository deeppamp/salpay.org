# SalPay mainnet environment template
# Copy to server as salpay/.env.server (or compose env) and fill secrets.
# Do NOT commit real secrets.

SALPAY_NETWORK=mainnet
MAINNET_STRICT_GUARDS=true

# --- Treasury (50% of mint fee) ---
MINT_TREASURY_ADDRESS_MAINNET=SC11aKyafJ116XJ9VG9Xt4C8hjXEpMcivH3TKwnxgkjeFcPJAJtz3v4fXXYVBMRBUX7q4iZVHqjKnML2SszqqMHk99jLdupNNb

# --- Fee paid in SAL1, priced in USD (~$20 cheapest … $50 top by name length) ---
FEE_CURRENCY=usd
# Live SAL/USD: auto = CoinGecko first, then manual fallback, then last good cache.
# Options: auto | coingecko | manual
SAL_USD_PRICE_SOURCE=auto
COINGECKO_COIN_ID=salvium
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Cache refresh interval (ms). Default 5 minutes.
# SAL_USD_RATE_CACHE_MS=300000
# Safety clamps (reject oracle spikes outside this range)
# SAL_USD_RATE_MIN=0.0001
# SAL_USD_RATE_MAX=100
# Manual fallback USD per 1 SAL1 (used if CoinGecko is down or PRICE_SOURCE=manual)
SAL_USD_MANUAL_RATE=0.05
FEE_USD_BUFFER_PERCENT=3
# Length tiers (no specialty names):
#   7+ chars → $20
#   5–6     → $35
#   1–4     → $50

# --- User pays 100% fee to treasury; operator burns 50% after mint (any wallet can mint) ---
# User payment is always a single SAL1 transfer to treasury (see buildPaymentOutputs).
# Operator machine polls GET /api/ops/burn-queue and posts burn tx via POST /api/ops/burn-complete.
MINT_BURN_PERCENT=50
MINT_BURN_KIND=protocol
# Do NOT set MINT_BURN_ADDRESS when using protocol burn for operator burns.
# Leave false (default): users never need protocol burn in their wallet.
MINT_USER_SPLIT_PAYMENT=false
# Secret for ops burn worker (other computer). Required for /api/ops/*
OPS_API_KEY=REPLACE_WITH_LONG_RANDOM_OPS_SECRET

# --- Payment verification ---
MINT_PAYMENT_VERIFICATION_MODE=chain_proof
MINT_CHAIN_PROOF_MIN_CONFIRMATIONS=1
PAYMENT_MODE=client_wallet

# --- Turnstile ---
TURNSTILE_ENFORCE=true
TURNSTILE_SECRET=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SITE_KEY

# --- Authoritative uniqueness ---
# Names: SalPay registry is source of truth until a chain name index exists.
# Built-in registry (minted-names DB + active reservations). Prefer "self" (in-process, no HTTP loop).
# Or point at the public HTTP API: https://salpay.org/api/registry/check?name={name}
AUTHORITATIVE_NAME_CHECK_URL=self
AUTHORITATIVE_TICKER_CHECK_URL=self
AUTHORITATIVE_NAME_CHECK_FAIL_CLOSED=true
AUTHORITATIVE_TICKER_CHECK_FAIL_CLOSED=true
# Live-chain ticker layer — see docs/TICKER-CHAIN-CHECK.md
#   stub          — SalPay DB + reserved SAL*/BURN only (safe day-1 launch)
#   wallet_rpc    — token_info/get_tokens via CHAIN_TICKER_RPC_URL (or treasury/view RPC)
#   https://...   — HTTP indexer { available, taken?, exists? }
# Day-1: stub. When token_info is reliable: wallet_rpc + CHAIN_CHECK_FAIL_CLOSED=true
CHAIN_NAME_CHECK_URL=stub
CHAIN_TICKER_CHECK_URL=stub
CHAIN_CHECK_FAIL_CLOSED=false
# CHAIN_TICKER_RPC_URL=http://127.0.0.1:29089/json_rpc

# --- Wallet RPC (required for chain_proof treasury verification) ---
# Prefer a dedicated view-only treasury wallet-rpc (no spend key on the server).
# Create with CLI:  salvium-wallet-cli --generate-from-svb-key <path>
#   Carrot wallet address:  MINT_TREASURY_ADDRESS_MAINNET
#   View-balance secret:    from CLI command `carrot_keys` → "view-balance secret"
#   NOT the classic `viewkey` secret (that will not see SAL1 Carrot deposits).
# Deploy helper: salpay/deploy/treasury-view/ (TREASURY_SVB_SECRET env, never commit).
#   TREASURY_VIEW_RPC_URL=http://127.0.0.1:29089/json_rpc
# Optional fallback if TREASURY_VIEW_RPC_URL is unset:
#   SALVIUM_RPC_URL=http://127.0.0.1:29089/json_rpc
# Do NOT put the full-spend treasury wallet on the public API server.
TREASURY_VIEW_RPC_URL=http://127.0.0.1:29089/json_rpc
# Publish mint treasury balance on website/GUI (requires view-only RPC above).
TREASURY_PUBLIC_STATS=true
# Optional public address label (defaults to MINT_TREASURY_ADDRESS_MAINNET):
# TREASURY_PUBLIC_ADDRESS=SC11aKyaf...
TREASURY_STATS_CACHE_MS=30000

PORT=3001
CORS_ALLOW_ORIGIN=https://salpay.org
NEXT_PUBLIC_API_BASE_URL=https://salpay.org
PUBLIC_API_BASE_URL=https://salpay.org
NAMES_DB_PATH=/var/lib/salpay/minted-names.json
NAME_IMAGES_DIR=/var/lib/salpay/name-images
MAX_NAME_IMAGE_BYTES=524288
